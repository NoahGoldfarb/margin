{
  "name": "margin",
  "productName": "Margin",
  "version": "1.0.0",
  "description": "Split a lecture PDF where you are looking and write Markdown + LaTeX there.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "vendor": "node vendor.js",
    "dist": "electron-builder --mac dmg",
    "app": "electron-builder --mac dir"
  },
  "devDependencies": {
    "electron": "^41.7.1",
    "electron-builder": "^24.13.3"
  },
  "optionalDependencies": {
    "katex": "^0.16.47",
    "marked": "12.0.2",
    "pdfjs-dist": "^5.6.205"
  },
  "build": {
    "appId": "dev.margin.app",
    "mac": {
      "icon": "build/icon-small.icns",
      "category": "public.app-category.education",
      "target": [
        "dir",
        "dmg"
      ]
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "templates/**",
      "vendor/**"
    ]
  }
}
